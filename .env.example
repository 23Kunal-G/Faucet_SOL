# ==============================================================================
# Multi-Chain Faucet Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URL=mongodb://127.0.0.1:27017/faucet_sol

# Global Admin Wallet Identifier
SEED_ADMIN_ADDRESS=0x9A3B57bE5dC22c0C157E0e6aF477D87bEecD7e6F

# ------------------------------------------------------------------------------
# Solana Network Configuration (Phase 1 Focus)
# ------------------------------------------------------------------------------
# Solana RPC Endpoint (Devnet, Testnet, or Mainnet)
SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

# Solana Admin / Faucet Public Address
SOLANA_ADMIN_ADDRESS=7Np41oeYqPefeNQEHSv1UDhYrehxin3NStELsSKCT4K2

# Solana Faucet Hot Wallet Private Key (byte array JSON: [12,34,56,...])
# If left empty, the faucet automatically requests Devnet airdrop for development testing.
SOLANA_FAUCET_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Sepolia Network Configuration (Phase 2)
# ------------------------------------------------------------------------------
# Sepolia RPC URL (Infura, Alchemy, or Public RPC)
SEPOLIA_RPC_ENDPOINT=https://rpc.sepolia.org

# Sepolia Admin Wallet Address
SEPOLIA_ADMIN_ADDRESS=0x9A3B57bE5dC22c0C157E0e6aF477D87bEecD7e6F

# Deployed Faucet Solidity Contract Address on Sepolia
SEPOLIA_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Sepolia Faucet Private Key (Optional for backend dispenser)
SEPOLIA_FAUCET_PRIVATE_KEY=

